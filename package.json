{
  "name": "tessil-cli-workspace",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "sync-core": "bun run scripts/sync-core.ts",
    "dev": "bun run packages/cli/src/main.ts",
    "build": "bun build packages/cli/src/main.ts --compile --outfile dist/tessil && (test \"$(uname)\" != Darwin || codesign --force --sign - dist/tessil)",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/bun": "^1.3.0",
    "lefthook": "^2.1.6",
    "typescript": "^5.9.3"
  }
}
